# ==============================================================================
# SOCIAL PLATFORM - FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# Sao chép file này thành .env để cấu hình môi trường phát triển local:
#   cp .env.example .env
# ==============================================================================

# Backend API Base Path (mặc định: /api)
VITE_API_BASE_URL=/api

# Địa chỉ ASP.NET Core Backend để Vite Proxy chuyển tiếp request trong môi trường Dev
# Ví dụ: http://localhost:5126 hoặc https://localhost:7126
VITE_BACKEND_URL=http://localhost:5126

# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Tên ứng dụng hiển thị
VITE_APP_NAME=Social Platform

# Môi trường chạy ứng dụng (development | staging | production)
VITE_APP_ENV=development
