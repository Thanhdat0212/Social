# ==============================================================================
# SECRETS, CREDENTIALS & SENSITIVE DATA (KHÔNG ĐƯA LÊN GIT)
# ==============================================================================
# Environment variables
**/.env
**/.env.*
**/*.env
!**/.env.example

# ASP.NET configuration secrets
**/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
!**/appsettings.template.json
**/secrets.json
**/*.user

# Private keys, certificates & credentials
**/*.pfx
**/*.pem
**/*.key
**/*.cer
**/*.crt
**/credentials.json
**/token.json
**/id_rsa*
**/id_ed25519*

# SQL scripts, seed data & database backups/dumps
*.sql
*.sql.bak
*.sql.dump
*.dump
*.bak

# Temporary & Plan files
*ke-hoach*.md
*plan*.md
scratch/

