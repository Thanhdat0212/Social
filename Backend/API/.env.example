# ==============================================================================
# SOCIAL PLATFORM - BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env:
#    cp .env.example .env
# 2. Điền các giá trị thực tế vào file .env
# 3. Không commit file .env chứa key thật lên Git!
# ==============================================================================

# 1. DATABASE (Supabase PostgreSQL Connection String)
ConnectionStrings__DefaultConnection="Host=<your-supabase-host>;Port=5432;Database=postgres;Username=postgres.<your-project-ref>;Password=<your-db-password>;SSL Mode=Require;Trust Server Certificate=true"

# 2. JWT AUTHENTICATION
Jwt__SigningKey="your-super-secret-jwt-signing-key-minimum-32-chars-long"
Jwt__Issuer="SocialApi"
Jwt__Audience="SocialClient"
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# 3. GOOGLE OAUTH 2.0
Google__ClientId="your-google-client-id.apps.googleusercontent.com"
Google__ClientSecret="your-google-client-secret"

# 4. CLOUDINARY MEDIA STORAGE
Cloudinary__CloudName="your-cloudinary-cloud-name"
Cloudinary__ApiKey="your-cloudinary-api-key"
Cloudinary__ApiSecret="your-cloudinary-api-secret"

# 5. GOOGLE GEMINI AI
Gemini__ApiKey="your-gemini-api-key"
Gemini__Model="gemini-3.8-flash"
Gemini__ApiEndpoint="https://generativelanguage.googleapis.com/v1beta/models"
Gemini__MinConfidenceThreshold=0.5

# 6. EMAIL SENDER & SMTP
Email__Provider="Smtp"
Email__FromAddress="your-email@gmail.com"
Email__FromName="Mạng xã hội Social"

Smtp__Host="smtp.gmail.com"
Smtp__Port=587
Smtp__Username="your-email@gmail.com"
Smtp__Password="your-app-password"
Smtp__EnableSsl=true

# 7. BREVO EMAIL (Tùy chọn)
Brevo__ApiKey=""

# 8. APPLICATION & CORS URLS
App__FrontendBaseUrl="http://localhost:5173"

# 9. SERVER & LOGGING CONFIGURATION
AllowedHosts="*"
Logging__LogLevel__Default="Information"
Logging__LogLevel__Microsoft.AspNetCore="Warning"
